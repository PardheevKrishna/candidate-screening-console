# Optional. Copy to .streamlit/secrets.toml (gitignored) only if you need to pin the proxy token.
# Normally nothing is needed: the "Screening Copilot Proxy" VS Code extension writes a connection
# file that the app finds automatically (see docs/COPILOT_PROXY.md).
# If you set a token here (or in the COPILOT_PROXY_TOKEN environment variable), it must be the
# one that the VS Code command "Screening Proxy: Copy Token" copies to the clipboard.
# Never commit real tokens.
# COPILOT_PROXY_TOKEN = "paste-the-token-here"
